<Window x:Class="AppShelf.App.Spotlight.SpotlightWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AppShelf.App.ViewModels"
        xmlns:local="clr-namespace:AppShelf.App"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        FontFamily="{StaticResource AppFont}" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        Activated="OnActivated" Deactivated="OnDeactivated">

    <Border Background="{StaticResource SurfaceWindow}" CornerRadius="12"
            Effect="{StaticResource CardShadow}" Padding="16"
            MinWidth="480" MaxWidth="600">
        <StackPanel>
            <!-- Search input row -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="Segoe Fluent Icons"
                           FontSize="16" Foreground="{StaticResource TextSecondary}"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox Grid.Column="1" x:Name="SearchTextBox"
                         Style="{StaticResource InputBox}"
                         Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                         BorderThickness="0" Background="Transparent"
                         FontSize="15" Padding="0,6"
                         PreviewKeyDown="OnSearchKeyDown"/>
            </Grid>

            <!-- Hairline separator (only when results > 0) -->
            <Border Height="1" Background="{StaticResource BorderHairline}" Margin="0,8,0,8"
                    Visibility="{Binding HasResults, Converter={StaticResource BoolToVis}}"/>

            <!-- Results list (only when results > 0) -->
            <ListBox x:Name="ResultsListBox"
                     ItemsSource="{Binding Results}"
                     SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}"
                     MaxHeight="320"
                     Background="Transparent" BorderThickness="0"
                     KeyboardNavigation.DirectionalNavigation="Cycle"
                     Visibility="{Binding HasResults, Converter={StaticResource BoolToVis}}">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Padding" Value="8,6"/>
                        <Setter Property="Margin" Value="0,1"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="ItemBg" Background="Transparent"
                                            CornerRadius="6" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBg" Property="Background"
                                                    Value="{StaticResource AccentMuted}"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ItemBg" Property="Background"
                                                    Value="{StaticResource SurfaceElevated}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ResultRow}">
                        <StackPanel>
                            <TextBlock Text="{Binding Name}"
                                       Foreground="{StaticResource TextPrimary}" FontSize="14"/>
                            <TextBlock Text="{Binding Subtitle}"
                                       Foreground="{StaticResource TextSecondary}" FontSize="11"
                                       Visibility="{Binding Subtitle, Converter={StaticResource StringToVis}}"
                                       Margin="0,1,0,0"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
    </Border>
</Window>
