<Window x:Class="AppShelf.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AppShelf.App"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="AppShelf" Height="640" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource SurfaceWindow}" Foreground="{StaticResource TextPrimary}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <!-- Spike: the whole window is now the WebView2-hosted React/Tailwind/shadcn UI.
         The old WPF card grid is preserved in git history. -->
    <Grid Background="{StaticResource SurfaceWindow}">
        <wv2:WebView2 x:Name="WebView"
                      CoreWebView2InitializationCompleted="WebView_OnInitializationCompleted"/>
    </Grid>
</Window>
