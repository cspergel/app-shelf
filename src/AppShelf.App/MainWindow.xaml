<Window x:Class="AppShelf.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AppShelf.App"
        Title="AppShelf" Height="640" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource SurfaceWindow}" Foreground="{StaticResource TextPrimary}"
        FontFamily="{StaticResource AppFont}" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <!-- Favorites filter chip: ghost until checked, then violet-tinted fill. -->
        <Style x:Key="FavoriteToggle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderHairline}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentMuted}"/>
                    <Setter Property="Foreground" Value="{StaticResource AccentHover}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource SurfaceElevated}"/>
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsChecked" Value="True"/>
                        <Condition Property="IsMouseOver" Value="True"/>
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="{StaticResource AccentMuted}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource AccentHover}"/>
                </MultiTrigger>
            </Style.Triggers>
        </Style>

        <!-- One-click favorite star in card headers: calm faint outline (☆) that brightens on its
             own hover; warm gold filled ★ when favorited. Chrome-less Button (no toggle two-way
             binding against the computed IsFavorite) — clicks never arm a drag because
             CardDragDrop ignores gestures starting on a ButtonBase. -->
        <Style x:Key="CardStarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Content" Value="☆"/>
            <Setter Property="Foreground" Value="{StaticResource TextFaint}"/>
            <Setter Property="Opacity" Value="0.55"/>
            <Setter Property="ToolTip" Value="Favorite"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="1"/>
                </Trigger>
                <!-- Last trigger wins for conflicting setters: favorited stays gold + full
                     opacity regardless of hover. -->
                <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                    <Setter Property="Content" Value="★"/>
                    <Setter Property="Foreground" Value="#E5C04B"/>
                    <Setter Property="Opacity" Value="1"/>
                    <Setter Property="ToolTip" Value="Unfavorite"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Standalone app card (drag source + drop target via CardDragDrop, Slice 2).
             Perf structure: the drop shadow lives on STATIC underlay Borders behind the card body,
             so the hover lift, the starting pulse, and the logs slide never invalidate the
             (expensive) effect bitmap — only the cheap effect-free body animates. "Shadow deepens"
             on hover is a cross-fade of the hover underlay's Opacity (composition-only) instead of
             an Effect-instance swap. The hover trigger sources from the static root Grid so the
             lifted body can't enter/leave-flicker along its bottom edge. -->
        <DataTemplate x:Key="AppCardTemplate">
            <Grid x:Name="CardRoot" Width="406" Margin="0,0,12,12"
                  local:CardDragDrop.IsCardAttached="True">
                <Border CornerRadius="10" Background="{StaticResource SurfaceCard}"
                        Effect="{StaticResource CardShadow}"/>
                <Border x:Name="HoverShadow" Opacity="0" CornerRadius="10"
                        Background="{StaticResource SurfaceCard}"
                        Effect="{StaticResource CardShadowHover}"/>
                <Border x:Name="CardBody" Padding="16" CornerRadius="10"
                        Background="{StaticResource SurfaceCard}"
                        BorderBrush="{StaticResource BorderHairline}" BorderThickness="1">
                <Border.RenderTransform>
                    <TranslateTransform Y="0"/>
                </Border.RenderTransform>
                <StackPanel>
                    <!-- Header: status glow + dot, name, favorite star, type badge -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,8,0">
                            <Ellipse Width="16" Height="16"
                                     Fill="{Binding Status, Converter={StaticResource StatusToBrush}}">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Opacity" Value="0"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                <Setter Property="Opacity" Value="0.25"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsStarting}" Value="True">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard x:Name="Pulse">
                                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                             From="0.05" To="0.4" Duration="0:0:0.7"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <StopStoryboard BeginStoryboardName="Pulse"/>
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <Ellipse Width="9" Height="9" Fill="{Binding Status, Converter={StaticResource StatusToBrush}}"
                                     ToolTip="{Binding StatusText}"/>
                        </Grid>
                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <Button Grid.Column="2" Style="{StaticResource CardStarButton}" Margin="0,0,6,0"
                                Command="{Binding ToggleFavoriteCommand}"/>
                        <Border Grid.Column="3" Style="{StaticResource ChipBorder}" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource ChipText}" Text="{Binding TypeBadge}"/>
                        </Border>
                    </Grid>

                    <!-- Tags chip (violet-tinted, only when present) -->
                    <Border Style="{StaticResource TagChipBorder}" HorizontalAlignment="Left" Margin="24,6,0,0"
                            Visibility="{Binding TagsText, Converter={StaticResource StringToVis}}">
                        <TextBlock Text="{Binding TagsText}" FontSize="11" Foreground="{StaticResource AccentHover}"/>
                    </Border>

                    <!-- Meta row: monospace URL left, last-launched right -->
                    <Grid Margin="24,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Foreground="{StaticResource TextSecondary}" FontSize="11"
                                   FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis">
                            <Run Text="{Binding Url, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Grid.Column="1" Text="{Binding LastLaunchedText}" Margin="8,0,0,0"
                                   Foreground="{StaticResource TextFaint}" FontSize="11" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Pre-flight reason: plain-English block on a failed launch (wraps) -->
                    <TextBlock Margin="24,8,0,0" TextWrapping="Wrap" FontSize="11"
                               Foreground="{StaticResource StatusError}" Text="{Binding Reason}"
                               Visibility="{Binding Reason, Converter={StaticResource StringToVis}}"/>

                    <!-- Action row: primary + contextual + overflow menu -->
                    <DockPanel Margin="0,12,0,0" LastChildFill="False">
                        <Button DockPanel.Dock="Left" Content="Run setup" Style="{StaticResource PrimaryButton}"
                                Command="{Binding RunSetupCommand}"
                                ToolTip="Run the install command, then retry"
                                Visibility="{Binding CanRunSetup, Converter={StaticResource BoolToVis}}"/>
                        <Button DockPanel.Dock="Left" Content="▶ Launch" Style="{StaticResource PrimaryButton}"
                                Command="{Binding LaunchCommand}"
                                Visibility="{Binding IsStopped, Converter={StaticResource BoolToVis}}"/>
                        <Button DockPanel.Dock="Left" Content="Open" Style="{StaticResource PrimaryButton}"
                                Command="{Binding OpenCommand}"
                                Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"/>
                        <Button DockPanel.Dock="Left" Content="Stop" Style="{StaticResource GhostButton}"
                                Command="{Binding StopCommand}"
                                Visibility="{Binding IsStopped, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"/>
                        <Button DockPanel.Dock="Right" Content="⋯" Style="{StaticResource GhostButton}"
                                Padding="10,6" Click="MoreButton_OnClick">
                            <Button.ContextMenu>
                                <ContextMenu Style="{StaticResource CardMenu}"
                                             DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                    <MenuItem Header="Restart" Style="{StaticResource CardMenuItem}" Command="{Binding RestartCommand}"/>
                                    <MenuItem Header="Logs" Style="{StaticResource CardMenuItem}" Command="{Binding ToggleLogsCommand}"/>
                                    <MenuItem Header="Edit" Style="{StaticResource CardMenuItem}" Command="{Binding EditCommand}"/>
                                    <Separator Style="{StaticResource MenuDivider}"/>
                                    <MenuItem Header="Remove" Style="{StaticResource CardMenuItem}" Command="{Binding RemoveCommand}"
                                              Foreground="{StaticResource StatusError}"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </DockPanel>

                    <!-- Logs panel: inset terminal, fade+slide on open -->
                    <Border Margin="0,10,0,0" Background="{StaticResource SurfaceWindow}" CornerRadius="6" Padding="8"
                            Visibility="{Binding ShowLogs, Converter={StaticResource BoolToVis}}">
                        <Border.RenderTransform>
                            <TranslateTransform Y="0"/>
                        </Border.RenderTransform>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowLogs}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     From="0" To="1" Duration="{StaticResource MotionFast}">
                                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)"
                                                                     From="-6" To="0" Duration="{StaticResource MotionFast}">
                                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBox Text="{Binding Logs, Mode=OneWay}" IsReadOnly="True" BorderThickness="0"
                                 Background="Transparent" Foreground="#B9C0C8" FontFamily="{StaticResource MonoFont}" FontSize="11"
                                 MaxHeight="160" VerticalScrollBarVisibility="Auto"
                                 TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto"/>
                    </Border>
                </StackPanel>
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <Trigger SourceName="CardRoot" Property="IsMouseOver" Value="True">
                    <Setter TargetName="CardBody" Property="Background" Value="{StaticResource SurfaceCardHover}"/>
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="CardBody"
                                                 Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)"
                                                 To="-1" Duration="{StaticResource MotionFast}">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="HoverShadow"
                                                 Storyboard.TargetProperty="Opacity"
                                                 To="1" Duration="{StaticResource MotionFast}">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="CardBody"
                                                 Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)"
                                                 To="0" Duration="{StaticResource MotionFast}">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="HoverShadow"
                                                 Storyboard.TargetProperty="Opacity"
                                                 To="0" Duration="{StaticResource MotionFast}">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Group-member card: same content/wiring as the app card but chrome-less —
             edge-to-edge with a top hairline divider, no shadow/border/lift. -->
        <DataTemplate x:Key="MemberCardTemplate">
            <Border Background="Transparent" Margin="0" Padding="0"
                    local:CardDragDrop.IsCardAttached="True">
                <StackPanel>
                    <Border Height="1" Background="{StaticResource BorderHairline}" Margin="0,0,0,10"/>

                    <!-- Header: status glow + dot, name, favorite star, type badge -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,8,0">
                            <Ellipse Width="16" Height="16"
                                     Fill="{Binding Status, Converter={StaticResource StatusToBrush}}">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Opacity" Value="0"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                <Setter Property="Opacity" Value="0.25"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsStarting}" Value="True">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard x:Name="MemberPulse">
                                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                             From="0.05" To="0.4" Duration="0:0:0.7"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <StopStoryboard BeginStoryboardName="MemberPulse"/>
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <Ellipse Width="9" Height="9" Fill="{Binding Status, Converter={StaticResource StatusToBrush}}"
                                     ToolTip="{Binding StatusText}"/>
                        </Grid>
                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <Button Grid.Column="2" Style="{StaticResource CardStarButton}" Margin="0,0,6,0"
                                Command="{Binding ToggleFavoriteCommand}"/>
                        <Border Grid.Column="3" Style="{StaticResource ChipBorder}" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource ChipText}" Text="{Binding TypeBadge}"/>
                        </Border>
                    </Grid>

                    <!-- Tags chip -->
                    <Border Style="{StaticResource TagChipBorder}" HorizontalAlignment="Left" Margin="24,6,0,0"
                            Visibility="{Binding TagsText, Converter={StaticResource StringToVis}}">
                        <TextBlock Text="{Binding TagsText}" FontSize="11" Foreground="{StaticResource AccentHover}"/>
                    </Border>

                    <!-- Meta row -->
                    <Grid Margin="24,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Foreground="{StaticResource TextSecondary}" FontSize="11"
                                   FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis">
                            <Run Text="{Binding Url, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Grid.Column="1" Text="{Binding LastLaunchedText}" Margin="8,0,0,0"
                                   Foreground="{StaticResource TextFaint}" FontSize="11" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Pre-flight reason: plain-English block on a failed launch (wraps) -->
                    <TextBlock Margin="24,8,0,0" TextWrapping="Wrap" FontSize="11"
                               Foreground="{StaticResource StatusError}" Text="{Binding Reason}"
                               Visibility="{Binding Reason, Converter={StaticResource StringToVis}}"/>

                    <!-- Action row -->
                    <DockPanel Margin="0,12,0,12" LastChildFill="False">
                        <Button DockPanel.Dock="Left" Content="Run setup" Style="{StaticResource PrimaryButton}"
                                Command="{Binding RunSetupCommand}"
                                ToolTip="Run the install command, then retry"
                                Visibility="{Binding CanRunSetup, Converter={StaticResource BoolToVis}}"/>
                        <Button DockPanel.Dock="Left" Content="▶ Launch" Style="{StaticResource PrimaryButton}"
                                Command="{Binding LaunchCommand}"
                                Visibility="{Binding IsStopped, Converter={StaticResource BoolToVis}}"/>
                        <Button DockPanel.Dock="Left" Content="Open" Style="{StaticResource PrimaryButton}"
                                Command="{Binding OpenCommand}"
                                Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"/>
                        <Button DockPanel.Dock="Left" Content="Stop" Style="{StaticResource GhostButton}"
                                Command="{Binding StopCommand}"
                                Visibility="{Binding IsStopped, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"/>
                        <Button DockPanel.Dock="Right" Content="⋯" Style="{StaticResource GhostButton}"
                                Padding="10,6" Click="MoreButton_OnClick">
                            <Button.ContextMenu>
                                <ContextMenu Style="{StaticResource CardMenu}"
                                             DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                    <MenuItem Header="Restart" Style="{StaticResource CardMenuItem}" Command="{Binding RestartCommand}"/>
                                    <MenuItem Header="Logs" Style="{StaticResource CardMenuItem}" Command="{Binding ToggleLogsCommand}"/>
                                    <MenuItem Header="Edit" Style="{StaticResource CardMenuItem}" Command="{Binding EditCommand}"/>
                                    <Separator Style="{StaticResource MenuDivider}"/>
                                    <MenuItem Header="Remove" Style="{StaticResource CardMenuItem}" Command="{Binding RemoveCommand}"
                                              Foreground="{StaticResource StatusError}"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </DockPanel>

                    <!-- Logs panel -->
                    <Border Margin="0,0,0,10" Background="{StaticResource SurfaceWindow}" CornerRadius="6" Padding="8"
                            Visibility="{Binding ShowLogs, Converter={StaticResource BoolToVis}}">
                        <Border.RenderTransform>
                            <TranslateTransform Y="0"/>
                        </Border.RenderTransform>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowLogs}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     From="0" To="1" Duration="{StaticResource MotionFast}">
                                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)"
                                                                     From="-6" To="0" Duration="{StaticResource MotionFast}">
                                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBox Text="{Binding Logs, Mode=OneWay}" IsReadOnly="True" BorderThickness="0"
                                 Background="Transparent" Foreground="#B9C0C8" FontFamily="{StaticResource MonoFont}" FontSize="11"
                                 MaxHeight="160" VerticalScrollBarVisibility="Auto"
                                 TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto"/>
                    </Border>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Group card: violet left edge container with aggregate pill + drill-in member list.
             Same perf structure as the app card: static shadow underlays behind an effect-free
             animating body (see AppCardTemplate comment). -->
        <DataTemplate x:Key="GroupCardTemplate">
            <Grid x:Name="GroupRoot" Width="406" Margin="0,0,12,12"
                  local:CardDragDrop.IsCardAttached="True">
                <Border CornerRadius="10" Background="{StaticResource SurfaceCard}"
                        Effect="{StaticResource CardShadow}"/>
                <Border x:Name="GroupHoverShadow" Opacity="0" CornerRadius="10"
                        Background="{StaticResource SurfaceCard}"
                        Effect="{StaticResource CardShadowHover}"/>
                <Border x:Name="GroupBody" Padding="16" CornerRadius="10"
                        Background="{StaticResource SurfaceCard}"
                        BorderBrush="{StaticResource BorderHairline}" BorderThickness="1">
                <Border.RenderTransform>
                    <TranslateTransform Y="0"/>
                </Border.RenderTransform>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Violet container edge -->
                    <Border Grid.Column="0" Width="3" Background="{StaticResource Accent}"
                            Opacity="0.6" CornerRadius="1.5"/>

                    <StackPanel Grid.Column="1" Margin="11,0,0,0">
                        <!-- Header: aggregate pill + group name + member count -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" CornerRadius="7" Padding="8,2" VerticalAlignment="Center"
                                    Margin="0,0,8,0"
                                    Background="{Binding StatusPill, Converter={StaticResource GroupStatusToBrush}}">
                                <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="#17181C" FontWeight="SemiBold"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <Border Grid.Column="2" Style="{StaticResource ChipBorder}" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource ChipText}" Text="{Binding MemberCountText}"/>
                            </Border>
                        </Grid>

                        <!-- Group actions -->
                        <WrapPanel Margin="0,12,0,0">
                            <Button Content="Start all" Style="{StaticResource PrimaryButton}" Command="{Binding StartAllCommand}"/>
                            <Button Content="Stop all" Style="{StaticResource GhostButton}" Command="{Binding StopAllCommand}"/>
                            <Button Content="Open" Style="{StaticResource GhostButton}" Command="{Binding OpenCommand}"/>
                            <Button Content="Rename" Style="{StaticResource GhostButton}" Command="{Binding RenameCommand}"
                                    ToolTip="Rename this group"/>
                            <Button Style="{StaticResource GhostButton}" Command="{Binding ToggleExpandCommand}"
                                    ToolTip="Show / hide members" Padding="10,6">
                                <Path Data="M 0 0 L 4 4 L 8 0" Stroke="{StaticResource TextSecondary}" StrokeThickness="1.6"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      RenderTransformOrigin="0.5,0.5" VerticalAlignment="Center" Margin="0,2,0,0">
                                    <Path.RenderTransform><RotateTransform Angle="0"/></Path.RenderTransform>
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard><Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(RotateTransform.Angle)"
                                                                             To="180" Duration="{StaticResource MotionFast}">
                                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard></BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                    <DataTrigger.ExitActions>
                                                        <BeginStoryboard><Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(RotateTransform.Angle)"
                                                                             To="0" Duration="{StaticResource MotionFast}">
                                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard></BeginStoryboard>
                                                    </DataTrigger.ExitActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                            </Button>
                        </WrapPanel>

                        <!-- Drill-in member cards: edge-to-edge with hairline dividers -->
                        <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding Members}"
                                      ItemTemplate="{StaticResource MemberCardTemplate}"
                                      Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.RenderTransform>
                                <TranslateTransform Y="0"/>
                            </ItemsControl.RenderTransform>
                            <ItemsControl.Style>
                                <Style TargetType="ItemsControl">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                         From="0" To="1" Duration="{StaticResource MotionFast}">
                                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)"
                                                                         From="-6" To="0" Duration="{StaticResource MotionFast}">
                                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.Style>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Vertical"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <Trigger SourceName="GroupRoot" Property="IsMouseOver" Value="True">
                    <Setter TargetName="GroupBody" Property="Background" Value="{StaticResource SurfaceCardHover}"/>
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="GroupBody"
                                                 Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)"
                                                 To="-1" Duration="{StaticResource MotionFast}">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="GroupHoverShadow"
                                                 Storyboard.TargetProperty="Opacity"
                                                 To="1" Duration="{StaticResource MotionFast}">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="GroupBody"
                                                 Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)"
                                                 To="0" Duration="{StaticResource MotionFast}">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="GroupHoverShadow"
                                                 Storyboard.TargetProperty="Opacity"
                                                 To="0" Duration="{StaticResource MotionFast}">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <local:TileTemplateSelector x:Key="TileSelector"
                                    GroupTemplate="{StaticResource GroupCardTemplate}"
                                    AppTemplate="{StaticResource AppCardTemplate}"/>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top bar: search, favorites filter, ports, refresh, add -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <TextBox x:Name="SearchBox" Style="{StaticResource InputBox}" Padding="28,6,8,6"
                         VerticalContentAlignment="Center"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Filter by name or #tag"/>
                <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons" FontSize="13"
                           Foreground="{StaticResource TextFaint}" IsHitTestVisible="False"
                           VerticalAlignment="Center" Margin="9,0,0,0"/>
                <TextBlock Text="Search apps or #tags" Foreground="{StaticResource TextFaint}"
                           IsHitTestVisible="False" VerticalAlignment="Center" Margin="30,0,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text.IsEmpty, ElementName=SearchBox}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <ToggleButton Grid.Column="1" Content="★ Favorites" Margin="12,0,8,0"
                          Style="{StaticResource FavoriteToggle}" VerticalAlignment="Center"
                          IsChecked="{Binding FavoritesOnly}"/>

            <Button Grid.Column="2" Content="Ports…" Style="{StaticResource GhostButton}"
                    Command="{Binding PortsCommand}" ToolTip="Scan and free dev-server ports"/>
            <Button Grid.Column="3" Content="↻" Style="{StaticResource GhostButton}"
                    Command="{Binding RefreshCommand}" ToolTip="Refresh"/>
            <Button Grid.Column="4" Content="+ Add App" Style="{StaticResource PrimaryButton}"
                    Command="{Binding AddCommand}"/>
        </Grid>

        <!-- Hairline divider below the bar -->
        <Border Grid.Row="1" Height="1" Background="{StaticResource BorderHairline}" Margin="0,0,0,12"/>

        <!-- Empty state -->
        <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="380"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
            <!-- shelf glyph: three stacked lines + dots, drawn in XAML -->
            <Canvas Width="56" Height="44" HorizontalAlignment="Center" Margin="0,0,0,14" Opacity="0.5">
                <Rectangle Canvas.Left="4" Canvas.Top="10" Width="48" Height="3" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource TextFaint}"/>
                <Rectangle Canvas.Left="4" Canvas.Top="24" Width="48" Height="3" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource TextFaint}"/>
                <Rectangle Canvas.Left="4" Canvas.Top="38" Width="48" Height="3" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource TextFaint}"/>
                <Ellipse Canvas.Left="10" Canvas.Top="2" Width="7" Height="7" Fill="{StaticResource Accent}"/>
                <Ellipse Canvas.Left="24" Canvas.Top="16" Width="7" Height="7" Fill="{StaticResource StatusRunning}"/>
            </Canvas>
            <TextBlock Text="{Binding EmptyHint}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"
                       TextAlignment="Center" HorizontalAlignment="Center" Foreground="{StaticResource TextPrimary}"/>
            <!-- Subtitle + CTA only when the shelf is truly empty (not merely filtered) -->
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding SearchText}" Value=""/>
                                    <Condition Binding="{Binding FavoritesOnly}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="Add a project and launch it with one click" Margin="0,4,0,14" FontSize="12"
                           HorizontalAlignment="Center" Foreground="{StaticResource TextSecondary}"/>
                <Button Content="+ Add App" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center"
                        Command="{Binding AddCommand}" Margin="0"/>
            </StackPanel>
        </StackPanel>

        <!-- Card grid -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
            <ItemsControl ItemsSource="{Binding Tiles}"
                          ItemTemplateSelector="{StaticResource TileSelector}"
                          local:CardDragDrop.IsCanvasAttached="True"
                          Background="Transparent">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>
