<Window x:Class="AppShelf.App.Dialogs.HotkeyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Spotlight Hotkey" Width="400" SizeToContent="Height" MinHeight="180"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource SurfaceWindow}" Foreground="{StaticResource TextPrimary}"
        FontFamily="{StaticResource AppFont}" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <!-- SizeToContent=Height so the button row is never clipped regardless of DPI/scaling. -->
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}"
                   Text="Press a new shortcut for the Spotlight overlay."/>

        <!-- Capture surface: focusable TextBox styled like the input field; it swallows keystrokes
             in PreviewKeyDown and shows the formatted combo instead of typed text. -->
        <TextBox x:Name="CaptureBox" Grid.Row="1" Style="{StaticResource InputBox}"
                 IsReadOnly="True" Cursor="Hand" Text="Press a shortcut…"
                 PreviewKeyDown="CaptureBox_OnPreviewKeyDown"/>

        <TextBlock x:Name="MessageText" Grid.Row="2" Margin="2,8,2,0"
                   TextWrapping="Wrap" Foreground="{StaticResource StatusError}"
                   Visibility="Collapsed"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,16,0,0">
            <Button Content="Use default" Click="UseDefaultButton_OnClick"
                    Style="{StaticResource GhostButton}"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Click="CancelButton_OnClick" Style="{StaticResource GhostButton}" IsCancel="True"/>
            <Button x:Name="SaveButton" Content="Save" Click="SaveButton_OnClick"
                    Style="{StaticResource PrimaryButton}" IsDefault="True" Margin="0"/>
        </StackPanel>
    </Grid>
</Window>
