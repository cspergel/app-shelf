<Window x:Class="AppShelf.App.Dialogs.PortsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ports" Height="480" Width="760"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceWindow}" Foreground="{StaticResource TextPrimary}"
        FontFamily="{StaticResource AppFont}" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Live dev-server ports — what is listening, and whose it is."
                       Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="Kill all orphaned" Style="{StaticResource DangerGhostButton}"
                    Command="{Binding KillAllOrphansCommand}"/>
            <Button Grid.Column="2" Content="↻ Refresh" Style="{StaticResource GhostButton}"
                    Command="{Binding RefreshCommand}"/>
        </Grid>

        <!-- Ports table -->
        <DataGrid Grid.Row="1" ItemsSource="{Binding Rows}" AutoGenerateColumns="False"
                  IsReadOnly="True" HeadersVisibility="Column" CanUserAddRows="False"
                  GridLinesVisibility="Horizontal" RowHeaderWidth="0"
                  Background="{StaticResource SurfaceCard}" Foreground="{StaticResource TextPrimary}"
                  BorderBrush="{StaticResource BorderHairline}"
                  RowBackground="{StaticResource SurfaceCard}"
                  AlternatingRowBackground="{StaticResource SurfaceElevated}"
                  HorizontalGridLinesBrush="{StaticResource BorderHairline}" SelectionMode="Single">
            <DataGrid.RowDetailsTemplate>
                <DataTemplate>
                    <Border Background="{StaticResource SurfaceWindow}"
                            BorderBrush="{StaticResource BorderHairline}"
                            BorderThickness="0,1,0,1"
                            Padding="16,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <!-- Header bar: label + Copy button — always visible -->
                                <RowDefinition Height="Auto"/>
                                <!-- Scrollable ancestry chain — capped height -->
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Header bar: "Ancestry" label + pinned Copy button -->
                            <Grid Grid.Row="0" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="Ancestry"
                                           Foreground="{StaticResource TextFaint}"
                                           FontSize="10"
                                           VerticalAlignment="Center"
                                           FontFamily="{StaticResource MonoFont}"/>
                                <Button Grid.Column="1"
                                        Content="{Binding CopyLabel}"
                                        Style="{StaticResource GhostButton}"
                                        FontSize="11"
                                        Padding="8,2"
                                        HorizontalAlignment="Right"
                                        Command="{Binding CopyAncestryCommand}"
                                        ToolTip="Copy the full ancestry chain to the clipboard"/>
                            </Grid>

                            <!-- Height-capped scrollable ancestry chain -->
                            <ScrollViewer Grid.Row="1"
                                          MaxHeight="200"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          PreviewMouseWheel="AncestryScrollViewer_PreviewMouseWheel">
                                <!-- Selectable, read-only chain (partial-copy works) -->
                                <TextBox Text="{Binding AncestryText, Mode=OneWay}"
                                         IsReadOnly="True"
                                         IsReadOnlyCaretVisible="False"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         Foreground="{StaticResource TextSecondary}"
                                         FontFamily="{StaticResource MonoFont}"
                                         FontSize="11"
                                         TextWrapping="Wrap"
                                         Padding="0"/>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </DataTemplate>
            </DataGrid.RowDetailsTemplate>
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="{x:Type DataGridColumnHeader}">
                    <Setter Property="Background" Value="{StaticResource SurfaceWindow}"/>
                    <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                    <Setter Property="FontSize" Value="11"/>
                    <Setter Property="Padding" Value="8,6"/>
                    <Setter Property="BorderThickness" Value="0"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.RowStyle>
                <Style TargetType="{x:Type DataGridRow}">
                    <Setter Property="DetailsVisibility"
                            Value="{Binding IsExpanded, Converter={StaticResource BoolToVis}}"/>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.CellStyle>
                <Style TargetType="{x:Type DataGridCell}">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{StaticResource AccentMuted}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.CellStyle>
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="" Width="28" CanUserResize="False" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="{Binding ExpandLabel}"
                                    Style="{StaticResource GhostButton}"
                                    FontSize="10"
                                    Padding="2,0"
                                    Command="{Binding ToggleExpandCommand}"
                                    ToolTip="Show/hide process ancestry"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Port" Binding="{Binding Port}" Width="60"/>
                <DataGridTextColumn Header="Process" Binding="{Binding Process}" Width="150"/>
                <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="70"/>
                <DataGridTemplateColumn Header="Tier" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Tier}" VerticalAlignment="Center" Margin="4,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource TextFaint}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Tier}" Value="Managed">
                                                <Setter Property="Foreground" Value="{StaticResource StatusRunning}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Tier}" Value="Registered">
                                                <Setter Property="Foreground" Value="{StaticResource AccentHover}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Tier}" Value="LikelyOrphaned">
                                                <Setter Property="Foreground" Value="{StaticResource StatusStarting}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Tier}" Value="Unknown">
                                                <Setter Property="Foreground" Value="{StaticResource TextFaint}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Service" Binding="{Binding ServiceBadge}" Width="80"/>
                <DataGridTextColumn Header="Owner" Binding="{Binding Owner}" Width="*"/>
                <DataGridTextColumn Header="Parent" Binding="{Binding ParentAlive}" Width="70"/>
                <DataGridTemplateColumn Header="" Width="70">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Kill" Style="{StaticResource DangerGhostButton}" Margin="2"
                                    Command="{Binding KillCommand}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Empty state -->
        <TextBlock Grid.Row="1" Text="No dev-server ports in use." Foreground="{StaticResource TextFaint}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"/>

        <TextBlock Grid.Row="2" Margin="0,10,0,0" Foreground="{StaticResource TextFaint}" FontSize="11"
                   Text="Tiers: Managed = AppShelf launched it · Registered = a registered app, parent alive · Likely-orphaned = registered but launcher dead · Unknown = not yours (never auto-killed)."
                   TextWrapping="Wrap"/>
    </Grid>
</Window>
