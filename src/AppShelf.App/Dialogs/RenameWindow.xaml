<Window x:Class="AppShelf.App.Dialogs.RenameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rename" Width="380" SizeToContent="Height" MinHeight="150"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource SurfaceWindow}" Foreground="{StaticResource TextPrimary}"
        FontFamily="{StaticResource AppFont}" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <!-- SizeToContent=Height so the button row is never clipped regardless of DPI/scaling. -->
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="FieldLabel" Grid.Row="0" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="ValueBox" Grid.Row="1" Style="{StaticResource InputBox}"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancel" Click="CancelButton_OnClick" Style="{StaticResource GhostButton}" IsCancel="True"/>
            <Button x:Name="OkButton" Content="OK" Click="OkButton_OnClick"
                    Style="{StaticResource PrimaryButton}" IsDefault="True" Margin="0"/>
        </StackPanel>
    </Grid>
</Window>
