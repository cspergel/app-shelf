<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\AppShelf.Core\AppShelf.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <UseWPF>true</UseWPF>
    <!-- WinForms only for System.Windows.Forms.NotifyIcon (tray); no NuGet dependency. -->
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>AppShelf</AssemblyName>
    <RootNamespace>AppShelf.App</RootNamespace>
  </PropertyGroup>

</Project>
