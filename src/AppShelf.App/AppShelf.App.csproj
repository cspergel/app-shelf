<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\AppShelf.Core\AppShelf.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Web UI host (spike): React/Tailwind/shadcn served into a WebView2 control. -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3124.44" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <UseWPF>true</UseWPF>
    <!-- WinForms only for System.Windows.Forms.NotifyIcon (tray); no NuGet dependency. -->
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>AppShelf</AssemblyName>
    <RootNamespace>AppShelf.App</RootNamespace>
    <ApplicationIcon>Resources\appshelf.ico</ApplicationIcon>
    <!-- Static WebView2 loader keeps single-file publish working later. -->
    <WebView2LoaderPreference>Static</WebView2LoaderPreference>
  </PropertyGroup>

  <ItemGroup>
    <!-- Embedded so the tray (and any window) can load it via a pack URI at runtime. -->
    <Resource Include="Resources\appshelf.ico" />
  </ItemGroup>

</Project>
